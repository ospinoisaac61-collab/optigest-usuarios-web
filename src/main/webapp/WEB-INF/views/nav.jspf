<%-- Barra de navegacion comun a todos los modulos de OptiGest ERP.
     Solo muestra los enlaces a los modulos que el rol del usuario puede abrir. --%>
<%
    Object usuarioSesionNav = session.getAttribute("usuarioSesion");
    String nombreNav = "";
    String rolNav = "";
    if (usuarioSesionNav instanceof com.optigest.usuariosweb.modelo.Usuario) {
        com.optigest.usuariosweb.modelo.Usuario u = (com.optigest.usuariosweb.modelo.Usuario) usuarioSesionNav;
        nombreNav = com.optigest.usuariosweb.util.Html.escapar(u.getNombre());
        rolNav = u.getRol();
    }
    String ctxNav = request.getContextPath();
%>
<nav class="barra-nav">
    <span class="marca">OptiGest ERP</span>
    <a href="<%= ctxNav %>/inicio">Inicio</a>
    <% if (com.optigest.usuariosweb.util.Permisos.puedeAcceder(rolNav, "usuarios")) { %><a href="<%= ctxNav %>/usuarios">Usuarios</a><% } %>
    <% if (com.optigest.usuariosweb.util.Permisos.puedeAcceder(rolNav, "productos")) { %><a href="<%= ctxNav %>/productos">Productos</a><% } %>
    <% if (com.optigest.usuariosweb.util.Permisos.puedeAcceder(rolNav, "proveedores")) { %><a href="<%= ctxNav %>/proveedores">Proveedores</a><% } %>
    <% if (com.optigest.usuariosweb.util.Permisos.puedeAcceder(rolNav, "compras")) { %><a href="<%= ctxNav %>/compras">Compras</a><% } %>
    <span class="nav-usuario"><%= nombreNav %></span>
    <a class="nav-salir" href="<%= ctxNav %>/logout">Cerrar sesi&oacute;n</a>
</nav>
