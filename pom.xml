<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.optigest</groupId>
  <artifactId>optigest-usuarios-web</artifactId>
  <version>1.0.0</version>
  <packaging>war</packaging>

  <name>OptiGest ERP - Modulo Web de Usuarios (Servlets + JSP)</name>
  <description>
    Modulo web de gestion de usuarios de OptiGest ERP (Aluminio y Vidrio).
    Formularios HTML procesados por Servlets (GET y POST) y vistas en JSP,
    con persistencia en PostgreSQL via JDBC.
    Evidencia GA7-220501096-AA2-EV02 - Modulos de software codificados y probados.
  </description>

  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <failOnMissingWebXml>false</failOnMissingWebXml>
  </properties>

  <dependencies>
    <!-- API de Servlets y JSP: la provee el contenedor (Jetty/Tomcat) en tiempo de ejecucion -->
    <dependency>
      <groupId>javax.servlet</groupId>
      <artifactId>javax.servlet-api</artifactId>
      <version>4.0.1</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>javax.servlet.jsp</groupId>
      <artifactId>javax.servlet.jsp-api</artifactId>
      <version>2.3.3</version>
      <scope>provided</scope>
    </dependency>

    <!-- Driver JDBC para PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.4</version>
    </dependency>
  </dependencies>

  <build>
    <finalName>optigest-usuarios-web</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-war-plugin</artifactId>
        <version>3.4.0</version>
      </plugin>

      <!-- Permite ejecutar la aplicacion sin instalar Tomcat: mvn jetty:run -->
      <plugin>
        <groupId>org.eclipse.jetty</groupId>
        <artifactId>jetty-maven-plugin</artifactId>
        <version>9.4.56.v20240826</version>
        <configuration>
          <webApp>
            <contextPath>/optigest-usuarios-web</contextPath>
            <!-- Carpeta temporal fuera de OneDrive: la sincronizacion bloquea
                 archivos y evita que Jetty los borre/recree al arrancar. -->
            <tempDirectory>C:\jetty-tmp\optigest-usuarios-web</tempDirectory>
          </webApp>
          <httpConnector>
            <port>8080</port>
          </httpConnector>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
